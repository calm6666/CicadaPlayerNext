#
# Put this in your home directory!
#
# NDK r25+ (clang/llvm) variant: no gcc toolchains, no gnu-libstdc++ — the
# unified sysroot provides libc++.
#

import os ;

########################################################################
########################################################################
########################################################################

local NDK_PLATFORM = [ os.environ ANDROID_API_LEVEL ] ;
if ! $(NDK_PLATFORM) { NDK_PLATFORM = 24 ; }

local NDK_ROOT = [ os.environ NDK_ROOT ] ;
local HOST = [ os.environ HOST ] ;
local ABI = [ os.environ ABI ] ;

local CROSS_COMPILE = [ os.environ CROSS_COMPILE ] ;
local ABI_NAME = [ os.environ ABI_NAME ] ;
local CPU_ARCH = [ os.environ CPU_ARCH ] ;

local NDK_HOST_PLATFORM = $(HOST)-x86_64 ;
local NDK_ARCH = $(ABI) ;
local NDK_TOOLCHAIN = $(CROSS_COMPILE) ;
local NDK_LLVM = $(NDK_ROOT)/toolchains/llvm/prebuilt/$(NDK_HOST_PLATFORM)/bin ;
local NDK_CXX = $(NDK_LLVM)/$(NDK_TOOLCHAIN)$(NDK_PLATFORM)-clang++ ;
local NDK_AR = $(NDK_LLVM)/llvm-ar ;
local NDK_RANLIB = $(NDK_LLVM)/llvm-ranlib ;
local NDK_SYSROOT = $(NDK_ROOT)/toolchains/llvm/prebuilt/$(NDK_HOST_PLATFORM)/sysroot ;

local TARGET = $(NDK_TOOLCHAIN)$(NDK_PLATFORM) ;

using clang : android_$(NDK_PLATFORM)_$(ABI_NAME) :
  $(NDK_CXX) :
  <archiver>$(NDK_AR)
  <ranlib>$(NDK_RANLIB)
  <compileflags>--target=$(TARGET)
  <compileflags>--sysroot=$(NDK_SYSROOT)
  <compileflags>-std=c++11
  <compileflags>-MMD
  <compileflags>-MP
  <compileflags>-MF
  <compileflags>-fpic
  <compileflags>-ffunction-sections
  <compileflags>-funwind-tables
  <compileflags>-fstack-protector
  <compileflags>-no-canonical-prefixes
  <compileflags>-Os
  <compileflags>-DNDEBUG
  <compileflags>-fomit-frame-pointer
  <compileflags>-fno-strict-aliasing
  <compileflags>-DANDROID
  <compileflags>-Wa,--noexecstack
  <compileflags>-Wformat
  <compileflags>-Werror=format-security
  <compileflags>-DBOOST_FILESYSTEM_VERSION=3
  ;
############################################################################
