<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 保持屏幕常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        读取本地视频：**必须先申请权限再读，不硬读**。
          · Android 13（API 33）+ ：READ_MEDIA_VIDEO
          · Android 14（API 34）+ ：再加 READ_MEDIA_VISUAL_USER_SELECTED（"仅允许访问选中的照片和视频"）
          · Android 12（API 32）及以下：READ_EXTERNAL_STORAGE
        申请与检查见 player/LocalVideoPicker.kt 的 LocalMediaAccess。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        截图保存到相册（Pictures/CicadaPlayer，见 components/video/CicadaVideoPlayer.kt 的
        saveSnapshotToGallery 与 requestCapture）：
          · Android 10（API 29）+ ：写自己插入的 MediaStore 条目**不需要**任何权限；
          · Android 9（API 28）及以下：需要 WRITE_EXTERNAL_STORAGE，所以只在这个区间声明
            （maxSdkVersion=28），运行时由 RequestPermission 申请；29+ 直接跳过申请。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CicadaPlayer"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CicadaPlayer"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>