<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_title" />

    <FrameLayout
        android:id="@+id/fl_video_container"
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- 对齐 ExoPlayer PlayerView：官方 AspectRatioFrameLayout(RESIZE_MODE_FIT)
             按视频宽高比测量视频区域，不同比例/全屏自动等比留黑边，永不拉伸 -->
        <com.google.android.exoplayer2.ui.AspectRatioFrameLayout
            android:id="@+id/video_aspect_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit">

            <com.cicada.player.demo.view.CicadaVodPlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.exoplayer2.ui.AspectRatioFrameLayout>

        <!-- 播放性能调试悬浮层：解码方式 / App CPU / 系统 CPU / GPU 占用，每秒刷新 -->
        <TextView
            android:id="@+id/tv_perf_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="#80000000"
            android:lineSpacingExtra="2dp"
            android:padding="6dp"
            android:text="@string/cicada_perf_debug"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:typeface="monospace" />
    </FrameLayout>

    <!-- 准备，播放，停止，暂停按钮 -->
    <LinearLayout
        android:id="@+id/ll_btn_group"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/white"
        android:orientation="horizontal">

        <Button
            android:id="@+id/prepare"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/prepare_button" />

        <Button
            android:id="@+id/play"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_button" />


        <Button
            android:id="@+id/pause"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pause_button" />

        <Button
            android:id="@+id/stop"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stop_button" />

        <Button
            android:id="@+id/snapshot"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/screenshot_button" />

        <Button
            android:id="@+id/retry"
            style="@style/btn_bordless_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/retry_button"
            android:textColor="@drawable/selector_button"
            android:visibility="gone" />

    </LinearLayout>
    <!-- 准备，播放，停止，暂停按钮 End -->

    <FrameLayout
        android:id="@+id/cicada_player_fm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cicada_white">

    </FrameLayout>

    <!-- 底部tag -->
    <RadioGroup
        android:id="@+id/radio_group_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/checkbox_player_options"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="options"
            android:textColor="@color/selector_tab_text_color" />

        <RadioButton
            android:id="@+id/checkbox_player_config"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="playerConfig"
            android:textColor="@color/selector_tab_text_color" />

        <RadioButton
            android:id="@+id/checkbox_cache_config"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="cacheConfig"
            android:textColor="@color/selector_tab_text_color" />

        <RadioButton
            android:id="@+id/checkbox_player_track"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="track"
            android:textColor="@color/selector_tab_text_color" />

    </RadioGroup>

</LinearLayout>